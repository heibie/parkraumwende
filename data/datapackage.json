          { "name": "Plätze",           "type": "integer", "description": "Gesamtzahl Stellplätze" },
          { "name": "Freie Plätze",     "type": "integer", "description": "Aktuell freie Stellplätze, sofern bekannt" },
          { "name": "Dauerparken",      "type": "string",  "description": "Dauerparken verfügbar (Ja/Nein)" },
          { "name": "Kurzzeitparken",   "type": "string",  "description": "Kurzzeitparken verfügbar (Ja/Nein)" },
          { "name": "Preis/Monat",      "type": "number",  "description": "Monatspreis in Euro, sofern bekannt" },
          { "name": "Preis/Tag",        "type": "number",  "description": "Tagespreis in Euro, sofern bekannt" },
          { "name": "Preis/Stunde",     "type": "number",  "description": "Stundenpreis in Euro, sofern bekannt" },
          { "name": "Parkplatz frei",   "type": "string",  "description": "Live-Verfügbarkeitsstatus, sofern der Parkplatz das unterstützt (Ja/Nein)" },
          { "name": "Status",           "type": "string",  "description": "Redaktioneller Freigabestatus des Eintrags (z.B. freigegeben)" },
          { "name": "Öffnungszeiten",   "type": "string",  "description": "Öffnungszeiten als Freitext, z.B. eingeschränkt/durchgehend" },
          { "name": "Straße",           "type": "string",  "description": "Straßenname" },
          { "name": "Hausnummer",       "type": "string",  "description": "Hausnummer" },
          { "name": "PLZ",              "type": "string",  "description": "Postleitzahl" },
          { "name": "Ort",              "type": "string",  "description": "Ort (i.d.R. München)" },
          { "name": "Einfahrtshöhe",    "type": "number",  "description": "Maximale Einfahrtshöhe in Metern, sofern bekannt" },
          { "name": "Latitude",         "type": "number",  "description": "Geographische Breite (WGS84)" },
          { "name": "Longitude",        "type": "number",  "description": "Geographische Länge (WGS84)" },
          { "name": "URL 1",            "type": "string",  "description": "Weiterführender Link, z.B. Betreiber-Webseite" },
          { "name": "URL 2",            "type": "string",  "description": "Weiterer Link, z.B. Preisliste" },
          { "name": "Places ID OpenData LHM", "type": "string", "description": "Verknüpfung zur OpenData-LHM-ID, sofern der Eintrag von dort stammt" },
          { "name": "Kontakt",          "type": "string",  "description": "Kontaktinformation, sofern bekannt" },
          { "name": "Bemerkung",        "type": "string",  "description": "Freitext-Anmerkung" },
          { "name": "Quelle",           "type": "string",  "description": "Datenherkunft des Eintrags" },
          { "name": "Potential",        "type": "string",  "description": "Redaktionelle Einschätzung, ob Umnutzungspotenzial für Parkraumwende besteht (Ja/Nein)" },
          { "name": "Erstellt am",      "type": "string",  "description": "Zeitstempel der Ersterfassung" },
          { "name": "Aktualisiert am",  "type": "string",  "description": "Zeitstempel der letzten Aktualisierung" }
        ]
      }
    },
    {
